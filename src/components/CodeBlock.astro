---
interface Props {
  code: string;
  file?: string;
  lang?: string;
  label?: string;
  copy?: boolean;
}
const { code, file = 'terminal', lang = 'bash', label, copy = true } = Astro.props;
const text = code.trim();
---

<div class="code">
  <div class="code__head">
    <span>{label ?? `${file} · ${lang}`}</span>
    {copy && (
      <button class="copy" type="button" data-copy aria-label={`Copy ${file}`} data-done="false">
        <span data-copy-label>Copy</span>
      </button>
    )}
  </div>
  <pre><code data-lang={lang}>{text}</code></pre>
</div>
