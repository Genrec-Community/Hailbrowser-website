---
interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, image = '/og.png', type = 'website', noindex = false, jsonLd = [] } = Astro.props;
const site = Astro.site ?? new URL('https://hailbrowser.genrecai.com');
const canonical = new URL(path, site).href;
const ogImage = new URL(image, site).href;
const fullTitle = title.includes('HailBrowser') ? title : `${title} — HailBrowser`;

const identity = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://genrecai.com/#org',
      name: 'GenrecAI',
      url: 'https://genrecai.com',
      description: 'GenrecAI builds practical AI tools and agents. HailBrowser is its open-source browser-use agent and browser MCP server.',
      logo: 'https://hailbrowser.genrecai.com/brand/logo.png',
      sameAs: ['https://genrecai.com', 'https://github.com/Genrec-Community'],
      founder: { '@id': 'https://hailbrowser.genrecai.com/#author' },
    },
    {
      '@type': 'Person',
      '@id': 'https://hailbrowser.genrecai.com/#author',
      name: 'Shyamnath Sankar',
      url: 'https://shyamnathsankar.genrecai.com/',
      worksFor: { '@id': 'https://genrecai.com/#org' },
      jobTitle: 'Founder, GenrecAI',
      sameAs: ['https://shyamnathsankar.genrecai.com/', 'https://github.com/Shyamnath-Sankar'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://hailbrowser.genrecai.com/#site',
      name: 'HailBrowser',
      url: 'https://hailbrowser.genrecai.com',
      description: 'HailBrowser: the fastest browser use ever made. An open-source Comet alternative for your own Chrome and a browser-use MCP server for Claude Code, OpenCode, Cursor and Codex.',
      inLanguage: 'en',
      publisher: { '@id': 'https://genrecai.com/#org' },
      author: { '@id': 'https://hailbrowser.genrecai.com/#author' },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://hailbrowser.genrecai.com/#app',
      name: 'HailBrowser',
      alternateName: ['HailBrowser Ultrafast', 'hailbrowser-mcp'],
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Browser automation, browser use, MCP server',
      operatingSystem: 'Windows, macOS, Linux (Chrome, Edge, Brave 116+)',
      url: 'https://hailbrowser.genrecai.com',
      downloadUrl: 'https://github.com/Shyamnath-Sankar/project-hailbrowser',
      license: 'https://opensource.org/license/mit',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: { '@id': 'https://hailbrowser.genrecai.com/#author' },
      publisher: { '@id': 'https://genrecai.com/#org' },
    },
  ],
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content="HailBrowser" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="HailBrowser: the fastest browser use, in the Chrome you are signed into" />
<meta property="og:locale" content="en" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#f2efe8" />
<meta name="color-scheme" content="light" />
<meta name="author" content="Shyamnath Sankar, GenrecAI" />
<meta name="keywords" content="browser use, browser use MCP, MCP browser, browser MCP server, Claude Code browser, OpenCode browser, Cursor browser MCP, Comet open source, open-source Comet alternative, AI browser agent, Chrome AI agent, fastest browser use, HailBrowser, Shyamnath Sankar, GenrecAI" />
<link rel="author" href="https://shyamnathsankar.genrecai.com/" />
<link rel="publisher" href="https://genrecai.com" />
<meta name="application-name" content="HailBrowser" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/brand/mark.svg" />
<link rel="manifest" href="/site.webmanifest" />

<link rel="preload" href="/fonts/switzer-800-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/switzer-400-normal.woff2" as="font" type="font/woff2" crossorigin />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
<script type="application/ld+json" set:html={JSON.stringify(identity)} />

