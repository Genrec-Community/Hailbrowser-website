---
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { SITE, BENCH, AUTHOR, COMPANY } from '../data/site';
import { CLIENTS } from '../data/clients';

const claude = CLIENTS.find((c) => c.id === 'claude-code')!;
const opencode = CLIENTS.find((c) => c.id === 'opencode')!;

const faq = [
  {
    q: 'What is a browser use MCP server?',
    a: 'It is a Model Context Protocol server that gives an AI agent browser tools: open a tab, read the page, click, type, choose from a menu, take a screenshot. HailBrowser is a browser use MCP server for the Chrome you are already signed into, so the agent works with your real sessions instead of a fresh, logged-out browser.',
  },
  {
    q: 'How do I let Claude Code use my browser?',
    a: 'Install the HailBrowser extension, then run: claude mcp add hailbrowser --scope user -- node /path/to/hailbrowser/mcp-server/src/index.js. Claude Code gets 18 browser tools plus run_task, and the side panel header turns green when it is connected.',
  },
  {
    q: 'Does it work with OpenCode, Cursor and Codex?',
    a: 'Yes. Any MCP client works. The docs have ready config blocks for Claude Code, OpenCode, Cursor, Codex CLI, Claude Desktop, Windsurf and Gemini CLI.',
  },
  {
    q: 'Will the agent take over the tab I am using?',
    a: 'No. MCP calls run in a separate agent window by default, and the side panel will not drive a tab a coding agent is using. You keep browsing while your agent works.',
  },
  {
    q: 'Why is it faster than driving the browser step by step?',
    a: 'An agent can hand a whole flow to run_task with mode "ultrafast". HailBrowser then runs its own decision loop locally, one small decision request per step, instead of a full round trip to the coding agent for every click. In our harness that averages 4.2 seconds per task, 26 of 26 passed.',
  },
  {
    q: 'Is it safe to give an agent my logged-in browser?',
    a: 'The hub listens on 127.0.0.1 only and rejects web pages and unknown extensions. Page text is treated as untrusted data, agents are told never to enter passwords or payment details, and you can turn external agents off in Settings at any time.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Browser use MCP server for Claude Code, OpenCode and Cursor',
    description:
      'HailBrowser is an open-source browser use MCP server: 18 browser tools for the Chrome you are signed into, plus an ultrafast run_task for whole flows.',
    url: `${SITE.url}/browser-mcp`,
    isPartOf: { '@id': `${SITE.url}/#site` },
    about: { '@id': `${SITE.url}/#app` },
    author: { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.url },
    publisher: { '@type': 'Organization', name: COMPANY.name, url: COMPANY.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Give Claude Code or OpenCode access to your real Chrome with an MCP server',
    totalTime: 'PT2M',
    step: [
      { '@type': 'HowToStep', name: 'Install the extension', text: 'Download HailBrowser, open chrome://extensions, turn on Developer mode and load the extension folder unpacked.' },
      { '@type': 'HowToStep', name: 'Add the MCP server', text: 'Add hailbrowser to your MCP client, for example: claude mcp add hailbrowser --scope user -- node /path/to/hailbrowser/mcp-server/src/index.js' },
      { '@type': 'HowToStep', name: 'Ask your agent', text: 'Ask your coding agent to use the browser. The HailBrowser side panel header turns green when it is connected.' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Browser use MCP', item: `${SITE.url}/browser-mcp` },
    ],
  },
];
---

<Base
  title="Browser Use MCP for Claude Code and OpenCode — HailBrowser"
  description="Open-source browser use MCP server for your real, logged-in Chrome. 18 tools for Claude Code, OpenCode, Cursor and Codex, plus an ultrafast run_task at 4.2s."
  jsonLd={jsonLd}
>
  <div class="frame">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <span aria-current="page">Browser use MCP</span>
    </nav>

    <header class="page-hero">
      <div class="page-hero__meta">
        <span class="pill pill--ink">MCP</span>
        <span class="pill">MIT · runs on 127.0.0.1</span>
      </div>
      <h1>Browser use MCP,<br />in your real Chrome.</h1>
      <p>
        HailBrowser is an open-source browser use MCP server. Add one config block and Claude Code,
        OpenCode, Cursor or Codex can read, click and type in the Chrome you are already signed into —
        not a blank automated browser that has to log in again. When a flow is long, your agent hands
        it to <code>run_task</code> in ultrafast mode, the fastest browser use we have measured.
      </p>
    </header>

    <section class="section section--flush">
      <div class="stats">
        <div class="stat">
          <b>18</b>
          <span>Browser tools over MCP</span>
          <em>Plus run_task and stop_task for whole flows.</em>
        </div>
        <div class="stat">
          <b>{BENCH.avg}</b>
          <span>Ultrafast, per task</span>
          <em>{BENCH.passed} of {BENCH.total} benchmark tasks, three full runs.</em>
        </div>
        <div class="stat">
          <b>{BENCH.real.passed}/{BENCH.real.total}</b>
          <span>Real sites</span>
          <em>Wikipedia, GitHub, YouTube, MDN, forms and more.</em>
        </div>
        <div class="stat">
          <b>7</b>
          <span>Clients with a ready config</span>
          <em>Claude Code, OpenCode, Cursor, Codex, Claude Desktop, Windsurf, Gemini CLI.</em>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="split split--wide-right">
        <div class="stack">
          <p class="label">Setup</p>
          <h2 class="display-l">One line for<br />Claude Code.</h2>
          <p class="body-muted">
            Install the extension first (<a class="link" href="/docs/install">two minutes</a>), then add
            the server. <code>npm run setup</code> prints every config with your real path.
          </p>
        </div>
        <div class="stack">
          <CodeBlock code={claude.code} file={claude.file} lang={claude.lang} label="Claude Code · terminal" />
          <CodeBlock code={opencode.code} file={opencode.file} lang={opencode.lang} label={`OpenCode · ${opencode.file}`} />
          <p class="note">
            Cursor, Codex CLI, Claude Desktop, Windsurf and Gemini CLI are on
            <a class="link" href="/docs/connect">Connect an agent</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="label">Why this one</p>
          <h2 class="display-m">Your browser, not a new one.</h2>
        </div>
        <p class="body-muted">
          Many browser MCP servers start a separate automated browser. That is the right choice for
          tests and scraping. For work that needs your accounts, it means logging in again, or not at all.
        </p>
      </div>

      <div class="data">
        <table>
          <caption>What your agent gets</caption>
          <thead>
            <tr><th scope="col">Question</th><th scope="col">HailBrowser MCP</th><th scope="col">A separate automated browser</th></tr>
          </thead>
          <tbody>
            <tr><td>Your logins and cookies</td><td>Already there: your normal Chrome profile</td><td>A fresh profile to sign into</td></tr>
            <tr><td>Your current tab</td><td>Left alone: agents get their own window</td><td>Not shared</td></tr>
            <tr><td>Long flows</td><td><code>run_task</code> ultrafast, {BENCH.avg} per task, runs locally</td><td>One agent round trip per click</td></tr>
            <tr><td>What you see</td><td>Animated border, agent cursor, Stop button, every step logged</td><td>Often headless</td></tr>
            <tr><td>Everyday use</td><td>The same extension is a Comet-style side panel</td><td>Developer tool only</td></tr>
            <tr><td>Licence</td><td>MIT, one public repository</td><td>Varies</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <div class="ways">
        <div class="way">
          <p class="label">Step by step</p>
          <h3>Your agent drives each click</h3>
          <p>
            <code>tabs_create</code>, <code>read_page</code>, <code>click</code>, <code>type</code>,
            <code>select_option</code>, <code>screenshot</code> and the rest. Elements come back as refs,
            so the agent never guesses coordinates. Good for debugging your own web app from Claude Code.
          </p>
          <a class="btn btn--ghost btn--sm" href="/docs/mcp">All the tools <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="way way--dark">
          <p class="label">Delegated</p>
          <h3>Hand the whole flow to ultrafast</h3>
          <p>
            <code>run_task</code> with <code>mode: "ultrafast"</code> runs HailBrowser’s own decision loop:
            one small request per step, the page re-checked before every input, and a stronger model
            taking over if it gets stuck. Your coding agent gets back the result, not forty tool calls.
          </p>
          <a class="btn btn--accent btn--sm" href="/benchmarks">See the benchmark <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="split split--wide-right">
        <div class="stack">
          <p class="label">Questions</p>
          <h2 class="display-m">Browser MCP, answered.</h2>
          <p class="body-muted">
            The rest are in the <a class="link" href="/faq">FAQ</a>.
          </p>
        </div>
        <div class="faq">
          {faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <nav class="more-links" aria-label="Related">
        <a href="/docs/connect">
          <span class="label">Set up</span>
          <b>Connect an agent</b>
          <em>Config for seven MCP clients.</em>
        </a>
        <a href="/use-cases/coding-agents">
          <span class="label">Guide</span>
          <b>Coding agents</b>
          <em>What Claude Code can do with your browser.</em>
        </a>
        <a href="/browser-use">
          <span class="label">Category</span>
          <b>Browser use</b>
          <em>The term, the loop, and the two shapes.</em>
        </a>
        <a href="/comet-alternative">
          <span class="label">Compare</span>
          <b>Open-source Comet</b>
          <em>The same extension, for everyday browsing.</em>
        </a>
      </nav>
    </section>
  </div>
</Base>
